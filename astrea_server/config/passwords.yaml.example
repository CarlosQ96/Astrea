# Astrea Server - Environment Configuration Example
# Copy this file to passwords.yaml and fill in your values
# IMPORTANT: passwords.yaml is gitignored and should never be committed

# Shared across all environments
shared:
  # Anthropic API key for Claude AI integration
  # Get your key at: https://console.anthropic.com/
  anthropicApiKey: 'sk-ant-api03-xxxxx'

# Development environment (local)
development:
  database: 'your_dev_db_password'
  redis: 'your_dev_redis_password'
  serviceSecret: 'generate_random_32_char_string'
  emailSecretHashPepper: 'generate_random_32_char_string'
  jwtHmacSha512PrivateKey: 'generate_random_32_char_string'
  jwtRefreshTokenHashPepper: 'generate_random_32_char_string'

# Test environment
test:
  database: 'your_test_db_password'
  redis: 'your_test_redis_password'
  emailSecretHashPepper: 'generate_random_32_char_string'
  jwtHmacSha512PrivateKey: 'generate_random_32_char_string'
  jwtRefreshTokenHashPepper: 'generate_random_32_char_string'

# Staging environment
staging:
  database: 'your_staging_db_password'
  serviceSecret: 'generate_random_32_char_string'
  emailSecretHashPepper: 'generate_random_32_char_string'
  jwtHmacSha512PrivateKey: 'generate_random_32_char_string'
  jwtRefreshTokenHashPepper: 'generate_random_32_char_string'

# Production environment
production:
  database: 'your_prod_db_password'
  serviceSecret: 'generate_random_32_char_string'
  emailSecretHashPepper: 'generate_random_32_char_string'
  jwtHmacSha512PrivateKey: 'generate_random_32_char_string'
  jwtRefreshTokenHashPepper: 'generate_random_32_char_string'
